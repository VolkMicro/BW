; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="TITHE & TERROR"
config/description="A god-sim / life-sim hybrid over the Ninefold Sea. Unnamed god, one rival, two bickering spirits, and a beast that learns."
run/main_scene="res://world/god_view.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
boot_splash/bg_color=Color(0.043, 0.047, 0.058, 1)
config/icon="res://icon.svg"

[autoload]

Naklon="*res://core/naklon.gd"
GameState="*res://core/game_state.gd"
Reach="*res://systems/faith/reach.gd"
Voices="*res://systems/voices/voices.gd"
Weather="*res://systems/weather/weather.gd"
MusicDirector="*res://audio/music_director.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=1

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
environment/defaults/default_environment="res://environment/world_environment.tres"
; Performance note (see docs/systems/engineering.md and the perf incident
; it was written to anticipate): this whole [rendering] block was tuned as
; a visual-quality ceiling in a sandbox with no GPU to ever measure it
; against, per that doc's own "design target, not yet measured" framing.
; The first real-hardware run came back at ~1 fps. These settings are the
; "practical levers" that same doc already named, pulled in the order it
; specified (resolution scale, then GI, then fog, then shadows) rather
; than as a guess — cutting draw distance/crowd counts was deliberately
; left as the last resort, per that doc, and isn't needed yet.
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/use_taa=true
occlusion_culling/use_occlusion_culling=true
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/directional_shadow/size=2048
global_illumination/gi/use_half_resolution=true
environment/ssao/quality=1
environment/ssil/quality=1
environment/glow/upscale_mode=1
environment/volumetric_fog/use_filter=0
textures/decals/filter=3
textures/light_projectors/filter=3
scaling_3d/mode=2
scaling_3d/scale=0.65
scaling_3d/fsr_sharpness=0.2

[physics]

3d/physics_engine="DEFAULT"

[input]

hand_grip={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"button_mask":1,"position":Vector2(0, 0),"global_position":Vector2(0, 0),"factor":1.0,"button_index":1,"canceled":false,"pressed":false,"double_click":false,"script":null)
]
}
